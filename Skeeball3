-- Improved ball detection
local function getCurrentBall()
    local arcade = workspace:FindFirstChild("arcade", true)
    if not arcade then return nil end
    
    local skeeball3 = arcade:FindFirstChild("Skeeball3")
    if not skeeball3 then return nil end

    -- 1. Prefer the loose starting Ball7
    local looseBall7 = skeeball3:FindFirstChild("Ball7")
    if looseBall7 and looseBall7.Parent == skeeball3 then
        return looseBall7
    end

    -- 2. Any other ball currently in the main Skeeball3 model
    for _, child in ipairs(skeeball3:GetChildren()) do
        if child:IsA("Part") and child.Name:match("^Ball%d+$") then
            return child
        end
    end

    -- 3. If none in main model, take the first ball from BallFolder
    local ballFolder = skeeball3:FindFirstChild("BallFolder")
    if ballFolder then
        for _, child in ipairs(ballFolder:GetChildren()) do
            if child:IsA("Part") and child.Name:match("^Ball%d+$") then
                return child
            end
        end
    end

    return nil
end

-- Left click to shoot
game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 or not enabled then 
        return 
    end

    local skeeball3 = workspace:FindFirstChild("arcade", true)
    if skeeball3 then
        skeeball3 = skeeball3:FindFirstChild("Skeeball3")
    end

    if not skeeball3 then
        statusLabel.Text = "Error: Skeeball3 not found"
        return
    end

    local holeModel = skeeball3:FindFirstChild("collision", true)
    if holeModel then
        holeModel = holeModel:FindFirstChild("Model")
    end

    if not holeModel then
        statusLabel.Text = "Error: Hole (collision.Model) not found"
        return
    end

    local targetCFrame = holeModel:GetPivot()
    local currentBall = getCurrentBall()

    if currentBall then
        currentBall.CFrame = targetCFrame
        statusLabel.Text = "✅ Shot " .. currentBall.Name .. " into the hole!"
        
        task.wait(0.8)
        statusLabel.Text = "Cheat: ENABLED ✅\nLeft click to shoot next ball"
    else
        statusLabel.Text = "❌ No ball found!"
    end
end)

