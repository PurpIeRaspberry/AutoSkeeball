statusLabel.Parent = frame

-- Big Toggle Button (Perfect for Mobile)
local toggleButton = Instance.new("TextButton")
toggleButton.Size = UDim2.new(0.9, 0, 0, 50)
toggleButton.Position = UDim2.new(0.05, 0, 0, 125)
toggleButton.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
toggleButton.Text = "OFF - Tap to Enable"
toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleButton.TextScaled = true
toggleButton.Font = Enum.Font.GothamBold
toggleButton.Parent = frame

local enabled = false

local function updateUI()
    if enabled then
        statusLabel.Text = "Cheat: ENABLED ✅"
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
        toggleButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        toggleButton.Text = "ON - Tap to Disable"
    else
        statusLabel.Text = "Cheat: DISABLED"
        statusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        toggleButton.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
        toggleButton.Text = "OFF - Tap to Enable"
    end
end

-- Toggle Button (Best for mobile)
toggleButton.MouseButton1Click:Connect(function()
    enabled = not enabled
    updateUI()
end)

-- Keep E key for PC users
game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.E then
        enabled = not enabled
        updateUI()
    end
end)

-- Ball detection
local function getCurrentBall()
    local arcade = workspace:FindFirstChild("arcade", true)
    if not arcade then return nil end
    local skeeball3 = arcade:FindFirstChild("Skeeball3")
    if not skeeball3 then return nil end

    local looseBall7 = skeeball3:FindFirstChild("Ball7")
    if looseBall7 and looseBall7.Parent == skeeball3 then return looseBall7 end

    for _, child in ipairs(skeeball3:GetChildren()) do
        if child:IsA("Part") and child.Name:match("^Ball%d+$") then
            return child
        end
    end

    local ballFolder = skeeball3:FindFirstChild("BallFolder")
    if ballFolder then
        for _, child in ipairs(ballFolder:GetChildren()) do
            if child:IsA("Part") and child.Name:match("^Ball%d+$") then
                return child
            end
        end
    end
    return nil
end

-- Left click / Tap to shoot
game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end
    if not enabled then return end

    local skeeball3 = workspace:FindFirstChild("arcade", true)
    if skeeball3 then skeeball3 = skeeball3:FindFirstChild("Skeeball3") end
    if not skeeball3 then return end

    local holeModel = skeeball3:FindFirstChild("collision", true)
    if holeModel then holeModel = holeModel:FindFirstChild("Model") end
    if not holeModel then return end

    local currentBall = getCurrentBall()
    if currentBall then
        currentBall.CFrame = holeModel:GetPivot()
        statusLabel.Text = "✅ Shot " .. currentBall.Name .. "!"
        task.wait(0.8)
        updateUI()
    else
        statusLabel.Text = "❌ No ball found!"
    end
end)

print("Skeeball Cheat GUI loaded (Mobile Friendly)")
